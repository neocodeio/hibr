# Express server port
PORT=5000

# Runtime mode: development | production. In production, error details
# are hidden from API responses and only localhost-exempt CORS stops.
NODE_ENV=development

# Comma-separated frontend origin(s) allowed to call this API, e.g.
# CORS_ORIGINS=https://hibr.space,https://www.hibr.space
# Localhost is only ever allowed outside production (local dev).
CORS_ORIGINS=

# Supabase. The service role key is required for the backend to write
# (it bypasses RLS). Don't leave template placeholders like
# "your_supabase_service_role_key_here" — they fail with "Invalid API key".
# Grab the real key from Supabase Dashboard → Settings → API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Clerk webhook signing secret (whsec_...)
CLERK_WEBHOOK_SECRET=
