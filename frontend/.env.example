# Frontend environment variables template — copy to .env and fill in

# Clerk authentication (publishable key — safe for the browser)
VITE_CLERK_PUBLISHABLE_KEY=

# Supabase (anon key — safe for the browser, RLS enforced)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Express backend API base URL (optional, defaults to http://localhost:5000)
VITE_API_URL=
